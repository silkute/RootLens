          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Ack"
                }
              }
            },
            "description": "Success"
          },
          "400": {
            "description": "Invalid or oversized input"
          },
          "401": {
            "description": "Authentication required"
          },
          "403": {
            "description": "Permission or CSRF failure"
          },
          "503": {
            "description": "Storage unavailable; retry without discarding data"
          }
        },
        "security": [
          {
            "agentBearer": []
          }
        ],
        "summary": "post /agent/batches"
      }
    },
