[Unit]
Description=RootLens diagnostics hub
After=network-online.target

[Service]
User=rootlens
Group=rootlens
ExecStart=/usr/local/bin/rootlens serve --data /var/lib/rootlens --listen 127.0.0.1:8443
Restart=on-failure
StateDirectory=rootlens
UMask=0077
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
CapabilityBoundingSet=
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
LockPersonality=true

[Install]
WantedBy=multi-user.target
